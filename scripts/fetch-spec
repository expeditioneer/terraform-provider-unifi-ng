#!/usr/bin/env bash
# Fetch the newest UniFi Network OpenAPI spec from beez.ly/unifi-apis/ that is an official release
# Writes to specs/network-<version>.json and specs/latest-version.txt
set -o errexit -o nounset -o pipefail

SPEC_BASE_URL="https://beez.ly/unifi-apis"
INDEX_URL="$SPEC_BASE_URL/"
# beez.ly also lists early access builds; only versions in this feed are official releases.
RELEASES_URL="https://community.ui.com/rss/releases/UniFi-Network-Controller/e6712595-81bb-4829-8e42-9e2630fabcfe"
SPECS_DIR="$(dirname "$0")/../specs"
mkdir --parents "$SPECS_DIR"

echo "Checking official UniFi Network releases..."

OFFICIAL=$(curl --silent --fail "$RELEASES_URL" | grep --only-matching --perl-regexp '<title><!\[CDATA\[UniFi Network Application \K[0-9]+\.[0-9]+\.[0-9]+(?=\]\]>)' | sort --version-sort --unique)
if [[ -z "$OFFICIAL" ]]; then
    echo "ERROR: Could not determine official releases from $RELEASES_URL" >&2
    exit 1
fi

AVAILABLE=$(curl --silent --fail "$INDEX_URL" | grep --only-matching --perl-regexp 'network-\K[0-9]+\.[0-9]+\.[0-9]+(?=\.json)' | sort --version-sort --unique)
if [[ -z "$AVAILABLE" ]]; then
    echo "ERROR: Could not determine spec versions from $INDEX_URL" >&2
    exit 1
fi

LATEST=$(grep --fixed-strings --line-regexp --file=<(echo "$OFFICIAL") <<<"$AVAILABLE" | tail --lines=1 || true)
if [[ -z "$LATEST" ]]; then
    echo "ERROR: No spec on $INDEX_URL matches an official release" >&2
    exit 1
fi

echo "Latest official version with spec: $LATEST"
NEWEST_OFFICIAL=$(tail --lines=1 <<<"$OFFICIAL")
if [[ "$NEWEST_OFFICIAL" != "$LATEST" ]]; then
    echo "Note: newest official release $NEWEST_OFFICIAL has no spec yet"
fi

CURRENT=""
if [[ -f "$SPECS_DIR/latest-version.txt" ]]; then
    CURRENT=$(<"$SPECS_DIR/latest-version.txt")
fi

if [[ "$CURRENT" == "$LATEST" && -f "$SPECS_DIR/network-$LATEST.json" ]]; then
    echo "Already at latest version ($LATEST), nothing to do."
    exit 0
fi

SPEC_URL="$SPEC_BASE_URL/network-$LATEST.json"
echo "Downloading $SPEC_URL..."
curl --silent --fail "$SPEC_URL" --output "$SPECS_DIR/network-$LATEST.json"
echo "$LATEST" > "$SPECS_DIR/latest-version.txt"
echo "Downloaded network-$LATEST.json"
echo "NEW_VERSION=$LATEST"
